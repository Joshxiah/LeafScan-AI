# ============================================================
# LeafScan AI - Backend Environment Variables (TEMPLATE)
#
# Copy this file, rename the copy to ".env", and fill in
# the real values. NEVER put real secrets in this template.
# ============================================================

# ---------- Server ----------
PORT=4000
NODE_ENV=development

# ---------- Database (XAMPP MySQL/MariaDB) ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=leafscan_ai

# ---------- Authentication (used in Phase 5) ----------
# Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ---------- File uploads (used in Phase 8) ----------
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# ---------- AI prediction service (used in Phase 13) ----------
AI_SERVICE_URL=http://localhost:8000