# ============================================================
# LeafScan AI - Backend Environment Variables (TEMPLATE)
#
# Copy this file, rename the copy to ".env", and fill in
# the real values. NEVER put real secrets in this template.
# ============================================================

# ---------- Server ----------
PORT=4000
NODE_ENV=development

# ---------- CORS ----------
# Comma-separated exact origins allowed to call this API from a
# browser once NODE_ENV is not "development", e.g.
#   ALLOWED_ORIGINS=https://admin.leafscan.example,https://app.leafscan.example
# In development the admin site (Vite, port 5173) and the mobile
# app's web build (Expo, port 8081) are already allowed from any
# host, so this can stay blank locally.
ALLOWED_ORIGINS=

# ---------- Database (XAMPP MySQL/MariaDB) ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=leafscan_ai

# ---------- Authentication (used in Phase 5) ----------
# Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string
# "Remember me" UNCHECKED at login: short session token.
JWT_EXPIRES_IN=1d
# "Remember me" CHECKED: long token kept on the phone, so the farmer
# stays signed in (and can work offline) without logging in again.
JWT_REMEMBER_EXPIRES_IN=90d

# ---------- Outgoing SMS (password reset) ----------
# FREE option - an Android phone as the SMS sender. Install the open-source
# "SMS Gateway for Android" app (https://sms-gate.app) on a phone with a SIM,
# switch on its Local Server, and copy what it shows here. The text is sent
# from that SIM (its own load / unli-text), with no service fee.
#   Local Server mode: phone and this PC must be on the SAME Wi-Fi.
#     SMS_GATEWAY_URL=http://192.168.1.50:8080/message   (IP shown in the app)
#   Cloud mode (works from anywhere, phone just needs internet):
#     SMS_GATEWAY_URL=https://api.sms-gate.app/3rdparty/v1/messages
# Check it with:  npm run test:sms -- 09XXXXXXXXX
SMS_GATEWAY_URL=
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=
# Paid alternative (used only if the gateway above is blank): sign up at
# https://semaphore.co to get a key.
# With BOTH blank, the reset code is printed to the backend console
# instead of being texted.
SEMAPHORE_API_KEY=
# Optional - must already be an approved sender name on the account.
SEMAPHORE_SENDER_NAME=
APP_NAME=LeafScan AI
PASSWORD_RESET_TTL_MINUTES=15

# ---------- Outgoing email via Brevo (CAO password reset) ----------
# The reset code email is sent through the Brevo HTTP API.
# BREVO_API_KEY is an API key (Brevo -> SMTP & API -> API Keys), not an SMTP key.
# MAIL_FROM_EMAIL must be a verified sender in Brevo.
# Never commit the real key: put it only in backend/.env.
BREVO_API_KEY=your_brevo_api_key_here
MAIL_FROM_EMAIL=your_verified_sender@example.com
MAIL_FROM_NAME=LeafScan AI

# ---------- Outgoing email (legacy Gmail, no longer used by the reset email) ----------
# The Gmail account the CAO "Forgot password" code is sent FROM.
# Leave both blank to run without it: the reset code is printed to
# the backend console instead of being emailed.
# GMAIL_APP_PASSWORD must be a Google "App password", not the normal
# Gmail password: Google Account -> Security -> turn on 2-Step
# Verification -> App passwords. Spaces in it are ignored.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ---------- File uploads (used in Phase 8) ----------
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# ---------- AI prediction service (used in Phase 13) ----------
AI_SERVICE_URL=http://localhost:8000